# Neon PostgreSQL connection string
# Set this in your Vercel project settings under Environment Variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional Vercel Blob token; Neon database storage is used if this is absent or unavailable.
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Optional authentication overrides; defaults are the requested RiSports account and reports PIN.
RISPORTS_EMAIL=risports@gmail.com
RISPORTS_PASSWORD_HASH=
RISPORTS_REPORTS_PIN=4321
